# ============================================================
# Mandaxpress — configuração de DESENVOLVIMENTO
# Gere um .env com segredos aleatórios:  ./scripts/init-env.sh dev
# (ou copie este arquivo para .env e troque todos os CHANGE_ME)
# Nunca versione o arquivo .env.
# ============================================================

# Arquivos do Compose usados por padrão ("docker compose up" lê esta variável).
# dev  = base + expõe o banco em 127.0.0.1 + serviço de testes
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Ambiente: development | production
APP_ENV=development

# --- Banco de dados (MariaDB) ---
MARIADB_DATABASE=mandaxpress
MARIADB_USER=mandaxpress
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
# Porta do banco publicada em 127.0.0.1 (somente desenvolvimento)
DB_HOST_PORT=3307

# --- Entrada HTTP (proxy reverso Caddy) ---
# Endereço do site no Caddy. ":80" = HTTP simples (local).
SITE_ADDRESS=:80
HTTP_PORT=8080

# --- Segurança web ---
# Origens autorizadas a fazer requisições que alteram dados (separadas por vírgula).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Cookie com flag Secure. false só é aceito fora de produção.
COOKIE_SECURE=false
# Sessão: expira após inatividade e também após um limite absoluto.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# --- Backend ---
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
