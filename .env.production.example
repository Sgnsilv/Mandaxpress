# ============================================================
# Mandaxpress — configuração de PRODUÇÃO (modelo, sem segredos)
# Gere um .env com segredos aleatórios:  ./scripts/init-env.sh prod
# Depois ajuste SITE_ADDRESS e ALLOWED_ORIGINS para o endereço público real.
# ============================================================

# base + 80/443 publicados pelo Caddy. O banco NÃO é publicado.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

APP_ENV=production

MARIADB_DATABASE=mandaxpress
MARIADB_USER=mandaxpress
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Domínio público (o Caddy obtém o certificado HTTPS sozinho).
# Se uma plataforma de hospedagem já termina o HTTPS, use ":80".
SITE_ADDRESS=CHANGE_ME_exemplo.com
# Origem pública exata, com https://
ALLOWED_ORIGINS=https://CHANGE_ME_exemplo.com
# Obrigatório true em produção (o backend recusa iniciar com false).
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Porta HTTP interna usada quando o Caddy não publica 80 (ver docker-compose.prod.yml)
HTTP_PORT=80
